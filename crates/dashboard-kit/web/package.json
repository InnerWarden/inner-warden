{
  "name": "innerwarden-dashboard-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:bundle": "node --test scripts/bundle-manifest.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build && node scripts/bundle-manifest.mjs write",
    "bundle:check": "node scripts/bundle-manifest.mjs check",
    "preview": "vite preview",
    "ci": "npm run test:unit && npm run test:bundle && npm run build && npm run bundle:check && npm run bundle:reproducible && npm run test:browser",
    "bundle:reproducible": "node scripts/reproducible.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
